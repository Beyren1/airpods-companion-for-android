    <string name="bg_title">Background mode</string>
    <string name="bg_description">Battery in the notification shade even when the app is closed. Android will ask to allow notifications and connecting to nearby devices: the latter lets the app notice right away when headphones connect.</string>
    <string name="autopause_title">Auto-pause</string>
    <string name="autopause_description">Pauses when you take out an earbud or remove the Max, and resumes when you put it back. Works in background mode.</string>
    <string name="case_popup_title">Pop-up when opening the case</string>
    <string name="case_popup_description">The first time you open the headphones’ case near the phone, a battery card appears at the bottom. Turn this off and on to show it again. Requires the “Display over other apps” permission.</string>
