<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 10–11: старые разрешения Bluetooth + геолокация обязательна для BLE-скана. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Геолокация: на Android 10–11 без неё нет BLE-скана, а на всех версиях — «где я оставил наушники»
         (место телефона в момент, когда наушники отключились). Просим её только на вкладке «Найти». -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- «Разрешать всегда»: наушники обычно отключаются, когда приложение закрыто. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Android 12+: скан без геолокации. neverForLocation может отфильтровать часть
         beacon-пакетов; если на Pixel пакеты 0x004C/0x07 пропадут, уберём флаг
         и будем просить геолокацию. Проверим на этапе 1. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Имя/статус сопряжённых устройств, A2DP-события, L2CAP-сокет AAP. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Уведомление с зарядом (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Постоянная связь с наушниками. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Жесты головой: узнать, что звонят, и ответить или отклонить звонок кивком. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- Окно с зарядом при открытии кейса: открыть его из фона можно только с этим разрешением. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- Связь с наушниками через Companion Device Manager: без неё Android не даёт сменить имя. -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <application
        android:name=".PodsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PodsCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Долгое нажатие на плитку в шторке открывает приложение. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Карточка с зарядом при открытии кейса. -->
        <activity
            android:name=".popup.CasePopupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PodsCompanion.Popup" />

        <service
            android:name=".service.PodsService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Наушники отключились: запоминаем место для вкладки «Найти». Эту рассылку Android
             доставляет и приёмнику из манифеста, когда приложение закрыто. -->
        <receiver
            android:name=".service.LastPlaceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <!-- Виджет на рабочем столе. -->
        <receiver
            android:name=".widget.PodsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pods_widget_info" />
        </receiver>

        <!-- Плитка в шторке быстрых настроек. -->
        <service
            android:name=".tile.PodsTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_pods"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
