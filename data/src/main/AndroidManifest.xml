<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ показывает приложению только те чужие приложения, о которых оно спросило.
         Музыкальные плееры объявляют MediaBrowserService: по нему находим их для выбора плеера,
         узнаём их названия и можем включить музыку, не открывая приложение. -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application>
        <!-- Доступ к уведомлениям нужен только ради списка плееров (MediaSession):
             сами уведомления приложение не читает. -->
        <service
            android:name=".media.MediaNotificationListener"
            android:exported="true"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
